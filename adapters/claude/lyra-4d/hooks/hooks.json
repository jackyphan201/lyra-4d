{
  "description": "Lyra 4-D: core once per session, a short intake note every turn, a log line when a skill or MCP tool runs.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lyra_hook.py\" --host claude --event session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lyra_hook.py\" --host claude --event prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Skill$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lyra_hook.py\" --host claude --event post-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
